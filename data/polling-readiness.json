{
  "schemaVersion": 1,
  "feature": "polling-center",
  "checkedDaily": true,
  "publicDisplayEnabled": true,
  "automatedPublishingEnabled": false,
  "methodology": {
    "label": "IRC Media Election Polls",
    "status": "individual-polls-no-average",
    "freshnessDays": 14,
    "supportedScopes": [
      "county-relevant",
      "florida-statewide",
      "national"
    ],
    "minimumRequiredFields": [
      "pollId",
      "raceId",
      "sourceId",
      "pollster",
      "startDate",
      "endDate",
      "population",
      "sampleSize",
      "answers",
      "sourceUrl",
      "scope",
      "countyIds",
      "displayStatus"
    ],
    "disclosure": "Polling reflects voter opinion during the dates surveyed. It is not a projection or election result."
  },
  "sources": [
    {
      "id": "change-research",
      "name": "Change Research",
      "type": "original-pollster-release",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://changeresearch.com/research/2026/2026-09-28-jolly-maintains-lead-in-florida-governors-race",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Original attributed release with linked AAPOR methodology statement; toplines are reported as factual polling results."
    },
    {
      "id": "quinnipiac-university-poll",
      "name": "Quinnipiac University Poll",
      "type": "original-pollster-release",
      "scope": [
        "national-approval",
        "national-generic-ballot"
      ],
      "documentationUrl": "https://poll.qu.edu/poll-release?releaseid=3968",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Original university poll release with complete sample, field dates, margin and methodology."
    },
    {
      "id": "emerson-college-polling",
      "name": "Emerson College Polling",
      "type": "original-pollster-release",
      "scope": [
        "national-generic-ballot"
      ],
      "documentationUrl": "https://emersoncollegepolling.com/september-2026-national-poll-democrats/",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Original pollster release with complete field dates, sample, credibility interval and methodology."
    },
    {
      "id": "manual-official-pollster-release",
      "name": "Other original pollster releases",
      "type": "manual",
      "scope": [
        "county-relevant",
        "florida-statewide",
        "national"
      ],
      "permittedForRepublication": false,
      "enabled": false,
      "note": "Remain disabled until each record has an original HTTPS release and complete methodology metadata."
    }
  ],
  "gates": {
    "schemaValidated": true,
    "sourceRightsValidated": true,
    "nationalCoverageValidated": true,
    "floridaCoverageValidated": true,
    "countyCoverageStateValidated": true,
    "duplicateDetectionValidated": true,
    "freshnessValidationValidated": true,
    "publicDisplayReady": true
  },
  "monitoring": {
    "enabled": true,
    "mode": "monitor-only-no-publishing",
    "workflow": ".github/workflows/polling-source-monitor.yml",
    "reportRetentionDays": 14,
    "note": "Daily checks produce a workflow artifact and do not modify polling.json or publish results."
  }
}
