{
  "schemaVersion": 1,
  "feature": "polling-center",
  "checkedDaily": true,
  "publicDisplayEnabled": true,
  "automatedPublishingEnabled": false,
  "methodology": {
    "label": "IRC Media Election Polls",
    "status": "individual-polls-no-average",
    "freshnessDays": 14,
    "supportedScopes": [
      "county-relevant",
      "florida-statewide",
      "national"
    ],
    "minimumRequiredFields": [
      "pollId",
      "raceId",
      "sourceId",
      "pollster",
      "startDate",
      "endDate",
      "population",
      "sampleSize",
      "answers",
      "sourceUrl",
      "scope",
      "countyIds",
      "displayStatus"
    ],
    "disclosure": "Polling reflects voter opinion during the dates surveyed. It is not a projection or election result."
  },
  "sources": [
    {
      "id": "st-pete-polls-florida-politics",
      "name": "St. Pete Polls / Florida Politics",
      "type": "commissioned-poll-release",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://floridapolitics.com/archives/827487-final-st-pete-polls-byron-donalds-leads-david-jolly-48-to-46-as-long-as-republicans-show-up/",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Commissioned public Florida polling release."
    },
    {
      "id": "siena-nyt",
      "name": "Siena Research Institute / The New York Times",
      "type": "original-university-poll-release",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://sri.siena.edu/2026/10/28/nytimes-siena-poll-of-likely-voters-florida-minnesota-and-south-carolina/",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Siena public release with Florida toplines and methodology links."
    },
    {
      "id": "activote",
      "name": "ActiVote",
      "type": "original-pollster-release",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://www.activote.net/polls/2026/fl-u-s-senate/",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Public ActiVote race pages include toplines, field dates, sample and methodology."
    },
    {
      "id": "echelon-netchoice",
      "name": "Echelon Insights / NetChoice",
      "type": "original-sponsor-release",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://netchoice.org/netchoice-echelon-insights-poll-voters-rank-ai-regulation-far-behind-cost-of-living-want-one-national-ai-standard/",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Public sponsor release includes Echelon Florida oversample results and methodology."
    },
    {
      "id": "redbox-research",
      "name": "RedBox Research / A Fight Worth Having",
      "type": "sponsored-poll-release",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://afightworthhaving.com/polling/2026/florida",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Public sponsored poll release; sponsor is disclosed."
    },
    {
      "id": "coefficient",
      "name": "co/efficient",
      "type": "original-pollster-release",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://battlegrounds.coefficient.org/fl/",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Public pollster page with Florida toplines, field dates, sample, mode and margin."
    },
    {
      "id": "unf-porl",
      "name": "University of North Florida Public Opinion Research Lab",
      "type": "original-university-poll-release",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://www.unf.edu/coas/porl/index.html",
      "permittedForRepublication": true,
      "enabled": true,
      "note": "Original university polling release with methodology."
    },
    {
      "id": "ddhq-public",
      "name": "Decision Desk HQ public Florida tracker",
      "type": "public-cross-check-only",
      "scope": [
        "florida-statewide"
      ],
      "documentationUrl": "https://votes.decisiondeskhq.com/polls/2026/florida",
      "permittedForRepublication": false,
      "enabled": false,
      "note": "Used only as a public discovery and cross-check page. No DDHQ paid API access or automated licensed-data ingestion."
    }
  ],
  "gates": {
    "schemaValidated": true,
    "sourceRightsValidated": true,
    "nationalCoverageValidated": true,
    "floridaCoverageValidated": true,
    "countyCoverageStateValidated": true,
    "duplicateDetectionValidated": true,
    "freshnessValidationValidated": true,
    "publicDisplayReady": true
  },
  "monitoring": {
    "enabled": true,
    "mode": "monitor-only-no-publishing",
    "workflow": ".github/workflows/polling-source-monitor.yml",
    "reportRetentionDays": 14,
    "note": "Daily checks produce a workflow artifact and do not modify polling.json or publish results."
  }
